static func t(key: String, lang: String) -> String:
	var table: Dictionary = STRINGS.get(lang, STRINGS["en"])
	if table.has(key):
		return table[key]
	var en: Dictionary = STRINGS["en"]
	if en.has(key):
		return en[key]
	return key
